# Copy to .env and fill in the key for the planner you use. .env is git-ignored.

# Gemini (python demo.py)
GEMINI_API_KEY=

# Claude (python demo.py claude)
# ANTHROPIC_API_KEY=

# Any OpenAI-compatible API (python demo.py openai)
# OPENAI_MODEL=gpt-5.1
# OPENAI_API_KEY=
# For a local or other server, set its URL; local servers usually need no key:
# OPENAI_BASE_URL=http://localhost:11434/v1
